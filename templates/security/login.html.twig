{% extends 'base.html.twig' %}
{% block title %}Owner sign in · QueryLens Manager{% endblock %}
{% block body %}<section class="panel narrow"><p class="eyebrow">PRIVATE ADMINISTRATION</p><h1>Owner sign in</h1><p>Manage demo invitations and inspect usage.</p>
{% if failed %}<p role="alert">Sign in failed. Check your credentials or try again later.</p>{% endif %}
<form method="post" action="{{ path('login') }}"><label for="username">Username</label><input id="username" name="_username" autocomplete="username" required maxlength="128"><label for="password">Password</label><input id="password" type="password" name="_password" autocomplete="current-password" required><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button>Sign in</button></form></section>{% endblock %}

{% extends 'base.html.twig' %}
{% block body %}<p class="eyebrow">ADMINISTRATION</p><div class="toolbar"><h1>Invitations</h1><a class="button" href="{{ path('invitation_create') }}">Create invitation</a></div><p class="muted">Named demo access. Lifetime limits preserve all previous usage.</p>
<section class="panel table-wrap"><table><thead><tr><th>Recipient label</th><th>Status</th><th>Questions left</th><th>Known cost</th><th>Expires (UTC)</th></tr></thead><tbody>
{% for invitation in invitations %}<tr><td><a href="{{ path('invitation_detail', {id: invitation.id}) }}">{{ invitation.name }}</a></td><td><span class="badge">{{ invitation.lifecycle|replace({'_':' '}) }}</span></td><td>{{ invitation.remaining_requests }} / {{ invitation.max_requests }}</td><td>{{ invitation.charged_micro_usd|micro_usd }}</td><td>{{ invitation.expires_at|date('Y-m-d H:i', 'UTC') }}</td></tr>{% else %}<tr><td colspan="5">No invitations yet.</td></tr>{% endfor %}
</tbody></table></section><nav>{% if page > 1 %}<a href="{{ path('console', {page: page-1}) }}">Previous</a>{% endif %}<span>Page {{ page }}</span>{% if more %}<a href="{{ path('console', {page: page+1}) }}">Next</a>{% endif %}</nav>{% endblock %}

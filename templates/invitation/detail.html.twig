{% extends 'base.html.twig' %}
{% block title %}{{ invitation.name }} · QueryLens Manager{% endblock %}
{% block body %}<a href="{{ path('console') }}">← Invitations</a><p class="eyebrow">USAGE DETAILS</p><h1>{{ invitation.name }}</h1><p><span class="badge">{{ invitation.lifecycle|replace({'_':' '}) }}</span> · <code>{{ invitation.id }}</code></p>
{% if invitation.revoked_at is null %}<div class="toolbar"><a class="button secondary" href="{{ path('invitation_edit', {id: invitation.id}) }}">Edit limits and expiry</a><form method="post" action="{{ path('invitation_revoke', {id: invitation.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('revoke-' ~ invitation.id) }}"><input type="hidden" name="operation" value="{{ revoke_operation }}"><button class="danger">Revoke invitation permanently</button></form></div><p class="help-text">Revocation immediately blocks future login and admission, including linked visitor sessions. Already admitted work may finish.</p>{% endif %}
<div class="metrics"><section class="panel metric">Questions remaining<strong>{{ invitation.remaining_requests }}</strong><span>{{ invitation.admitted_requests }} admitted / {{ invitation.max_requests }} lifetime total</span></section><section class="panel metric">Known estimated cost<strong>{{ invitation.charged_micro_usd|micro_usd }}</strong><span>Soft threshold {{ invitation.budget_micro_usd|micro_usd }}</span></section><section class="panel metric">Unknown usage<strong>{{ invitation.unknown_requests }}</strong><span>Excluded from known cost</span></section></div>
<section class="panel"><p>Created: {{ invitation.created_at|date('Y-m-d H:i:s', 'UTC') }} UTC<br>Expires: {{ invitation.expires_at|date('Y-m-d H:i:s', 'UTC') }} UTC<br>Revoked: {{ invitation.revoked_at ? invitation.revoked_at|date('Y-m-d H:i:s', 'UTC') ~ ' UTC' : 'No' }}<br>Last admitted question: {{ invitation.last_used_at ? invitation.last_used_at|date('Y-m-d H:i:s', 'UTC') ~ ' UTC' : 'Never' }}<br>Rate limit: {{ invitation.requests_per_minute }} questions/minute</p><p class="muted">The recipient label does not identify the person using a forwarded link. Known cost is a post-request estimate, not a provider balance. A final admitted question may cross the threshold.</p></section>
<h2>Request history</h2><p class="help-text">Pending: not completed. Unknown: incomplete accounting. Legacy: no measured cost. Not admitted: no charge. None are reported as zero-cost usage.</p>
<section class="panel table-wrap"><table><thead><tr><th>Request / admitted at (UTC)</th><th>Completed (UTC)</th><th>Outcome</th><th>Accounting / measured usage</th><th>Estimated cost</th></tr></thead><tbody>{% for row in requests %}<tr><td><code>{{ row.request_id }}</code><br>{{ row.created_at|date('Y-m-d H:i:s', 'UTC') }}</td><td>{{ row.completed_at ? row.completed_at|date('Y-m-d H:i:s', 'UTC') : 'Pending' }}</td><td>{{ row.outcome }}{% if row.error_category %}<br>{{ row.error_category }}{% endif %}</td><td>{{ row.usage_state|replace({'_':' '}) }}{% if row.model %}<br>{{ row.model }}{% endif %}{% if row.input_tokens is not null %}<br>{{ row.input_tokens }} input / {{ row.output_tokens ?? '—' }} output tokens{% endif %}{% if row.embedding_model %}<br>{{ row.embedding_model }}: {{ row.embedding_tokens ?? '—' }} tokens{% endif %}</td><td>{{ row.charged_micro_usd is not null ? row.charged_micro_usd|micro_usd : '—' }}</td></tr>{% else %}<tr><td colspan="5">No requests recorded.</td></tr>{% endfor %}</tbody></table></section>
<nav>{% if page > 1 %}<a href="{{ path('invitation_detail', {id: invitation.id, page: page-1}) }}">Previous</a>{% endif %}<span>Page {{ page }}</span>{% if more %}<a href="{{ path('invitation_detail', {id: invitation.id, page: page+1}) }}">Next</a>{% endif %}</nav>{% endblock %}

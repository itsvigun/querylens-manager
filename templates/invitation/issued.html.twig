{% extends 'base.html.twig' %}
{% block title %}Invitation issued · QueryLens Manager{% endblock %}
{% block body %}<p class="eyebrow">CREATED SUCCESSFULLY</p><h1>Copy this invitation now</h1><section class="panel"><p>This is the only response containing the code. It cannot be retrieved later. Share it privately with the intended recipient.</p><h2>Private invitation link</h2><code id="invitation-link">{{ link }}</code><h2>Invitation code</h2><code id="invitation-code">{{ issued.credential }}</code><p class="help-text">Refreshing or resubmitting will not create another invitation and will not recover this code. If this response is lost, inspect the invitation, revoke it and explicitly create a replacement.</p></section><a class="button" href="{{ path('invitation_detail', {id: issued.id}) }}">Continue to invitation details</a>{% endblock %}

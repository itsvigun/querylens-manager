# Copy to .env.local. Generate private values with the setup commands.
APP_ENV=dev
APP_DEBUG=0
APP_SECRET=
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=
# HTTP is permitted only for this loopback development origin.
APP_ORIGIN=http://localhost:8086
QUERYLENS_BASE_URL=https://querylens.example
# Add only a dedicated runtime connection after explicit owner provisioning.
MANAGER_DATABASE_URL=

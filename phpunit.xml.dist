<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd" bootstrap="tests/bootstrap.php" cacheDirectory=".phpunit.cache" failOnWarning="true" failOnRisky="true">
  <php><server name="APP_ENV" value="test" force="true"/><server name="APP_DEBUG" value="0" force="true"/><server name="KERNEL_CLASS" value="App\Kernel"/></php>
  <testsuites><testsuite name="QueryLens Manager"><directory>tests</directory></testsuite></testsuites>
</phpunit>

{
    "name": "itsvigun/querylens-manager",
    "description": "Owner-only administration for QueryLens invitations",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo_pgsql": "*",
        "ext-simplexml": "*",
        "doctrine/dbal": "^4.3",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/password-hasher": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "lint": [
            "@php bin/console cache:clear --no-warmup",
            "@php tools/lint.php",
            "@php bin/console lint:container",
            "@php bin/console lint:twig templates"
        ],
        "test": "phpunit --exclude-group database",
        "test:database": "phpunit --group database"
    },
    "conflict": {
        "symfony/cache": ">=8.0",
        "symfony/clock": ">=8.0",
        "symfony/config": ">=8.0",
        "symfony/dependency-injection": ">=8.0",
        "symfony/error-handler": ">=8.0",
        "symfony/event-dispatcher": ">=8.0",
        "symfony/filesystem": ">=8.0",
        "symfony/finder": ">=8.0",
        "symfony/http-foundation": ">=8.0",
        "symfony/http-kernel": ">=8.0",
        "symfony/options-resolver": ">=8.0",
        "symfony/property-access": ">=8.0",
        "symfony/property-info": ">=8.0",
        "symfony/routing": ">=8.0",
        "symfony/security-core": ">=8.0",
        "symfony/security-http": ">=8.0",
        "symfony/string": ">=8.0",
        "symfony/twig-bridge": ">=8.0",
        "symfony/type-info": ">=8.0",
        "symfony/var-dumper": ">=8.0",
        "symfony/var-exporter": ">=8.0",
        "symfony/dom-crawler": ">=8.0"
    }
}
